{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "home-control": {
      "type": "streamable-http",
      "url": "https://home-control.example.invalid/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "baseScopes": ["home:read"],
            "defaultScopes": ["home:read"]
          }
        }
      }
    }
  }
}
